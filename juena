cmd_env() { ## Create .env from env.example if it does not exist
    if [ -f .env ]; then
        echo ".env already exists; leaving it alone"
    else
        cp env.example .env
        echo "Created .env from env.example -- add your Blablador API key (BLABLADOR_API_KEY)"
    fi
}

# ---------------------------------------------------------------------------
# Running natively (uv)
# ---------------------------------------------------------------------------

cmd_run() { ## Run FastAPI natively on :8080 (bootstraps repositories first)
    export JUENA_RAG_URL="http://127.0.0.1:${RAG_PORT:-8100}"
    uv run main.py "$@"
}

cmd_ui() { ## Run the Streamlit UI natively on :9501
    export JUENA_RAG_URL="http://127.0.0.1:${RAG_PORT:-8100}"
    uv run streamlit run app/streamlit_app.py \
        --server.port="$UI_PORT" \
        --server.address=0.0.0.0 "$@"
}

sandbox_podman_uri() { ## Resolve the Podman API socket for this host
    # On macOS Podman runs inside a virtual machine, so its socket is not at the
    # standard Linux path; ask the machine where it published one. `podman info`
    # already reports the right path on both platforms when it is available.
    local socket
    socket="$(podman info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null)"
    if [ "$(uname -s)" = "Darwin" ]; then
        socket="$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null)"
    fi
    [ -n "$socket" ] || return 1
    case "$socket" in
        unix://*) printf '%s\n' "$socket" ;;
        *) printf 'unix://%s\n' "$socket" ;;
    esac
}

configure_sandbox() {
    local workspace_root
    command -v podman >/dev/null 2>&1 || die "Podman is required for sandbox execution."
    if ! podman info >/dev/null 2>&1; then
        if [ "$(uname -s)" = "Darwin" ]; then
            echo "Starting the rootless Podman machine..."
            podman machine start >/dev/null
        else
            die "Rootless Podman is unavailable for the current user."
        fi
    fi
    podman info >/dev/null 2>&1 || die "Rootless Podman did not become ready."

    export SANDBOX_PODMAN_URI="${SANDBOX_PODMAN_URI:-$(sandbox_podman_uri)}"
    [ -n "$SANDBOX_PODMAN_URI" ] || die "Could not determine the Podman socket path."
    export SANDBOX_IMAGE="${SANDBOX_IMAGE:-juena-sandbox:latest}"
    workspace_root="${SANDBOX_WORKSPACE_HOST_ROOT:-$(dotenv_value SANDBOX_WORKSPACE_HOST_ROOT)}"
    workspace_root="${workspace_root:-$SANDBOX_RUNTIME_DIR/workspaces}"
    case "$workspace_root" in
        /*) export SANDBOX_WORKSPACE_ROOT="$workspace_root" ;;
        *) export SANDBOX_WORKSPACE_ROOT="$REPO_ROOT/$workspace_root" ;;
    esac
    export DATABASE_URL="${SANDBOX_WORKER_DATABASE_URL:-$(dotenv_value SANDBOX_WORKER_DATABASE_URL)}"
    # Export one set for both consumers: Compose passes these to the API, and
    # the host worker inherits them below. An approval card must describe the
    # limits the worker will actually enforce.
    export SANDBOX_CPU_LIMIT="$(environment_value SANDBOX_CPU_LIMIT 1)"
    export SANDBOX_MEMORY_LIMIT="$(environment_value SANDBOX_MEMORY_LIMIT 1g)"
    export SANDBOX_WORKSPACE_LIMIT_BYTES="$(environment_value SANDBOX_WORKSPACE_LIMIT_BYTES 5368709120)"
    export SANDBOX_IDLE_TTL_SECONDS="$(environment_value SANDBOX_IDLE_TTL_SECONDS 86400)"
    [ -n "$DATABASE_URL" ] || die "SANDBOX_WORKER_DATABASE_URL is missing from .env"
    mkdir -p "$SANDBOX_WORKSPACE_ROOT"
    # setgid so that files JüNA writes as root still inherit the worker's group,
    # which is what lets the worker and the sandbox container manage them.
    chmod 2770 "$SANDBOX_WORKSPACE_ROOT"
}

# Both host-side processes are tracked the same way, so the "is it alive" and
# "stop it" rules live here once. A pid file naming a process that has since
# exited reads as stopped, which is what makes a machine that was rebooted
# mid-run recover by simply starting it again.
pid_file_is_running() {
    local pid_file="$1"
    [ -f "$pid_file" ] || return 1
    local pid
    read -r pid < "$pid_file" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

stop_pid_file() {
    local pid_file="$1"
    local name="$2"
    if ! pid_file_is_running "$pid_file"; then
        rm -f "$pid_file"
        return
    fi
    local pid
    read -r pid < "$pid_file"
    kill "$pid"
    local attempt
    for attempt in {1..50}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && die "$name did not stop (pid $pid)"
    rm -f "$pid_file"
}

worker_is_running() { pid_file_is_running "$SANDBOX_WORKER_PID_FILE"; }

start_sandbox_worker() {
    mkdir -p "$SANDBOX_RUNTIME_DIR"
    if worker_is_running; then
        return
    fi
    rm -f "$SANDBOX_WORKER_PID_FILE"

    PYTHONDONTWRITEBYTECODE=1 nohup uv run python -m juena_core.sandbox.worker \
        >"$SANDBOX_WORKER_LOG_FILE" 2>&1 &
    echo "$!" > "$SANDBOX_WORKER_PID_FILE"

    local attempt
    for attempt in {1..30}; do
        if worker_is_running; then
            sleep 1
            worker_is_running || break
            # Record only non-secret limits. A later `juena up` may find this
            # worker already alive; comparing against the current shell would
            # then prove what a *new* worker would inherit, not what this one
            # actually started with.
            : > "$SANDBOX_WORKER_LIMITS_FILE"
            for key in SANDBOX_CONCURRENCY SANDBOX_CPU_LIMIT SANDBOX_MEMORY_LIMIT \
                       SANDBOX_WORKSPACE_LIMIT_BYTES SANDBOX_IDLE_TTL_SECONDS; do
                printf '%s=%s\n' "$key" "${!key:-}" >> "$SANDBOX_WORKER_LIMITS_FILE"
            done
            return
        fi
        sleep 0.1
    done
    tail -n 30 "$SANDBOX_WORKER_LOG_FILE" >&2 || true
    die "sandbox worker failed to start; see $SANDBOX_WORKER_LOG_FILE"
}

stop_sandbox_worker() {
    stop_pid_file "$SANDBOX_WORKER_PID_FILE" "sandbox worker"
    rm -f "$SANDBOX_WORKER_LIMITS_FILE"
}

prepare_sandbox() {
    configure_sandbox
    podman build -t "$SANDBOX_IMAGE" -f deploy/sandbox/Dockerfile .
}

verify_sandbox_limits_agree() {
    # The API puts these numbers on the approval card and admits jobs against
    # them; the host worker is what Podman actually enforces. They are one
    # exported set, so a difference here means a value stopped being passed
    # through -- which is exactly how the card came to promise 2 vCPU / 4 GB
    # while the worker ran 1 vCPU / 2 GB, silently, for as long as nobody
    # compared them.
    local key api worker mismatch=0
    for key in SANDBOX_CONCURRENCY SANDBOX_CPU_LIMIT SANDBOX_MEMORY_LIMIT \
               SANDBOX_WORKSPACE_LIMIT_BYTES SANDBOX_IDLE_TTL_SECONDS; do
        # `exec` into a restarting container prints nothing and still exits 0,
        # so an empty answer is reported as unreadable rather than as a value.
        # Both being empty must never read as agreement.
        api="$("${COMPOSE_DEV[@]}" exec -T juena-chatbot printenv "$key" 2>/dev/null | tr -d '\r')"
        worker="$(awk -v key="$key" 'index($0, key "=") == 1 {sub(/^[^=]*=/, ""); print; exit}' "$SANDBOX_WORKER_LIMITS_FILE" 2>/dev/null || true)"
        if [ -z "$api" ]; then
            echo "  $key: unreadable in the API container (is it running?), worker '$worker'" >&2
            mismatch=1
        elif [ -z "$worker" ]; then
            echo "  $key: API '$api', unreadable for the running worker" >&2
            mismatch=1
        elif [ "$api" != "$worker" ]; then
            echo "  $key: API '$api', worker '$worker'" >&2
            mismatch=1
        fi
    done
    [ "$mismatch" -eq 0 ] || die "sandbox limits disagree between the API and the running worker (see above). Stop the old worker with 'juena sandbox-stop', then run 'juena up' again after correcting the environment."
}

wait_for_sandbox_stack() {
    local attempt
    for attempt in {1..90}; do
        if "${COMPOSE_DEV[@]}" exec -T postgres psql \
            -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc \
            "SELECT to_regclass('public.sandbox_jobs') IS NOT NULL" 2>/dev/null \
            | grep -qx t \
            && "${COMPOSE_DEV[@]}" exec -T juena-chatbot curl -fsS \
            http://127.0.0.1:8080/health >/dev/null 2>&1; then
            return
        fi
        sleep 1
    done
    die "JüNA or the sandbox_jobs table did not become ready; inspect 'juena logs'"
}

cmd_sandbox_stop() { ## Stop JüNA and the worker but leave PostgreSQL running
    require_env
    stop_sandbox_worker
    "${COMPOSE_DEV[@]}" stop juena-chatbot
    echo "JüNA and the sandbox worker stopped. PostgreSQL is still running."
    echo "Use 'juena postgres-down' to stop PostgreSQL too."
}

cmd_bootstrap() { ## Clone/refresh repositories at the commits juena-rag indexed
    uv run python -m juena.indexing.bootstrap "$@"
}

# ---------------------------------------------------------------------------
# Development Postgres
# ---------------------------------------------------------------------------

cmd_postgres_up() { ## Start only Postgres, published on :5432
    require_env
    "${COMPOSE_DEV[@]}" up -d postgres
}

cmd_postgres_down() { ## Stop Postgres, keeping its data volume
    require_env
    "${COMPOSE_DEV[@]}" stop postgres
}

cmd_postgres_reset() { ## DESTROYS development Postgres data. Needs --confirm
    require_env
    local confirmed="${CONFIRM:-}"
    case "${1:-}" in --confirm|-y|yes) confirmed=yes ;; esac
    if [ "$confirmed" != "yes" ]; then
        echo "refusing: this deletes the ${POSTGRES_VOLUME} volume and every" >&2
        echo "development user, chat, checkpoint and memory in it." >&2
        echo "Re-run with: juena postgres-reset --confirm" >&2
        exit 1
    fi
    "${COMPOSE_DEV[@]}" down
    docker volume rm "$POSTGRES_VOLUME"
}

# ---------------------------------------------------------------------------
# juena-rag, the search backend
# ---------------------------------------------------------------------------
#
# Retrieval and ingestion use the same pinned image and private Compose network.
cmd_rag_up() { ## Start bundled RAG and initialize its database if empty
    require_env
    "${COMPOSE_DEV[@]}" up -d --build --wait juena-rag "$@"
}

cmd_rag_down() { ## Stop bundled RAG and its database, retaining the corpus
    require_env
    "${COMPOSE_DEV[@]}" stop juena-rag rag-db
}

cmd_rag_logs() { ## Follow the bundled RAG service log
    require_env
    "${COMPOSE_DEV[@]}" logs -f juena-rag "$@"
}

# COMPOSE_INGEST is supplied by the development or server wrapper below.
ingest_repositories() {
    local status=0
    "${COMPOSE_INGEST[@]}" run --rm --build rag-ingest "$@" || status=$?
    case " $* " in
        *" --dry-run "*) ;;
        *)
            # Re-pin even after a partial failure: earlier repositories may have
            # completed. A stopped chatbot pins them during its next startup.
            if "${COMPOSE_INGEST[@]}" ps --status running --services | grep -qx juena-chatbot; then
                "${COMPOSE_INGEST[@]}" exec -T juena-chatbot python -m juena.indexing.bootstrap \
                    || status=1
            fi
            ;;
    esac
    return "$status"
}

cmd_repos_ingest() { ## Ingest selected repository IDs (all by default), then re-pin clones
    require_env
    COMPOSE_INGEST=("${COMPOSE_DEV[@]}")
    ingest_repositories "$@"
}

# ---------------------------------------------------------------------------
# Langfuse, the self-hosted tracing UI (deploy/langfuse/, deploy/LANGFUSE.md)
# ---------------------------------------------------------------------------
#
# Started on its own and left running: `juena down` does not touch it, so the
# traces at http://localhost:3000 stay there between chatbot restarts.

# The private network the chatbot container and Langfuse's web container
# share. External to both Compose projects -- so neither project's `down`
# removes it -- which means it is created here, by whichever starts first.
ensure_tracing_network() {
    docker network inspect juena-tracing >/dev/null 2>&1 \
        || docker network create juena-tracing >/dev/null
}

require_langfuse_env() {
    [ -f "$LANGFUSE_DIR/.env" ] \
        || die "$LANGFUSE_DIR/.env is missing. Run 'juena langfuse-up' first."
}

cmd_langfuse_up() { ## Start self-hosted Langfuse on http://localhost:3000 (kept running by 'down')
    if [ ! -f "$LANGFUSE_DIR/.env" ]; then
        cp "$LANGFUSE_DIR/env.example" "$LANGFUSE_DIR/.env"
        echo "Created $LANGFUSE_DIR/.env from env.example (development values)"
    fi
    ensure_tracing_network
    # Returns once the web *and* worker health checks pass. The first start
    # runs the database migrations and takes a minute or two.
    "${COMPOSE_LANGFUSE[@]}" up -d --wait --wait-timeout 300 "$@" \
        || die "Langfuse did not become healthy. See 'juena langfuse-logs'."
    # Only once the chatbot has keys to send with; until then the stack is up
    # and there is nothing to prove yet.
    uv run python scripts/langfuse_check.py --if-configured "$LANGFUSE_URL"
    echo "Langfuse  $LANGFUSE_URL"
    echo "${DIM}Login: LANGFUSE_INIT_USER_EMAIL / _PASSWORD in $LANGFUSE_DIR/.env${RESET}"
}

# Healthy containers do not prove traces arrive. This sends a test observation
# with the *chatbot's* keys from .env and reads it back, so it also proves the
# two key pairs match. The script reads .env itself, with python-dotenv like
# the application: this file's line parser keeps quotes and inline comments,
# so `KEY="pk-lf-..."` would reach Langfuse with its quotes on. The URL is the
# host's view of Langfuse: .env's LANGFUSE_BASE_URL is the container's.
cmd_langfuse_check() { ## Prove Langfuse stores traces sent with .env's keys
    [ -f .env ] || die ".env is missing. Run 'juena env' first."
    uv run python scripts/langfuse_check.py "$LANGFUSE_URL"
}

cmd_langfuse_down() { ## Stop Langfuse, keeping its traces
    require_langfuse_env
    "${COMPOSE_LANGFUSE[@]}" down "$@"
}

cmd_langfuse_logs() { ## Follow the Langfuse web and worker logs
    require_langfuse_env
    "${COMPOSE_LANGFUSE[@]}" logs -f langfuse-web langfuse-worker "$@"
}

cmd_langfuse_reset() { ## DESTROYS every Langfuse trace, login and key. Needs --confirm
    require_langfuse_env
    local confirmed="${CONFIRM:-}"
    case "${1:-}" in --confirm|-y|yes) confirmed=yes ;; esac
    if [ "$confirmed" != "yes" ]; then
        echo "refusing: this deletes the juena-langfuse-* volumes -- every trace," >&2
        echo "login and API key. The next 'juena langfuse-up' starts empty and" >&2
        echo "creates the login and keys again from $LANGFUSE_DIR/.env." >&2
        echo "Re-run with: juena langfuse-reset --confirm" >&2
        exit 1
    fi
    "${COMPOSE_LANGFUSE[@]}" down --volumes
}

# From inside the container, over the address the SDK will use. Warns, never
# fails: chats work without Langfuse, they are just not traced. The switch and
# the URL are read inside the container too: Compose has already parsed .env
# into its environment, quotes and all, which this file's line parser does not.
report_langfuse_reachability() {
    local result
    result="$("${COMPOSE_DEV[@]}" exec -T juena-chatbot sh -c '
        tracing="$(printf %s "$LANGFUSE_TRACING" | tr "[:upper:]" "[:lower:]")"
        [ "$tracing" = "true" ] || { echo off; exit 0; }
        curl -fsS -m 5 "${LANGFUSE_BASE_URL%/}/api/public/health" >/dev/null 2>&1 \
            && echo "ok $LANGFUSE_BASE_URL" || echo "unreachable $LANGFUSE_BASE_URL"
    ' 2>/dev/null)" || return 0
    case "$result" in
        ok\ *)
            echo "${DIM}The stack reaches Langfuse at ${result#ok }.${RESET}"
            echo "Traces  $LANGFUSE_URL (Langfuse)"
            ;;
        unreachable\ *)
            echo "warning: LANGFUSE_TRACING is on, but the juena-chatbot container" >&2
            echo "         cannot reach ${result#unreachable } -- traces are being dropped." >&2
            echo "         Start Langfuse with 'juena langfuse-up'." >&2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Development stack
# ---------------------------------------------------------------------------

cmd_up() { ## Start the full development stack (build if needed)
    require_env
    if [ "$SANDBOX_ENABLED" = true ]; then prepare_sandbox; fi
    if [ "$(environment_value LANGFUSE_TRACING false)" = true ]; then ensure_tracing_network; fi
    "${COMPOSE_DEV[@]}" up --build -d --wait --wait-timeout 900 --remove-orphans "$@"
    if [ "$SANDBOX_ENABLED" = true ]; then
        wait_for_sandbox_stack
        start_sandbox_worker
        verify_sandbox_limits_agree
    fi
    report_langfuse_reachability
    echo "UI      http://localhost:${UI_PORT}"
    echo "API     http://localhost:${API_PORT}"
    echo "Search  http://127.0.0.1:${RAG_PORT:-8100}"
}

cmd_down() { ## Stop the development stack, keeping volumes
    require_env
    stop_sandbox_worker
    "${COMPOSE_DEV[@]}" down "$@"
}

cmd_build() { ## Rebuild the image without starting anything
    require_env
    "${COMPOSE_DEV[@]}" build "$@"
}

cmd_logs() { ## Follow application logs (bootstrap progress appears here)
    require_env
    if [ -f "$SANDBOX_WORKER_LOG_FILE" ]; then
        echo "Recent sandbox worker log ($SANDBOX_WORKER_LOG_FILE):"
        tail -n 30 "$SANDBOX_WORKER_LOG_FILE"
        echo
    fi
    "${COMPOSE_DEV[@]}" logs -f juena-chatbot "$@"
}

cmd_ps() { ## Show development stack status
    require_env
    "${COMPOSE_DEV[@]}" ps "$@"
    if worker_is_running; then
        echo "sandbox-worker: running (pid $(<"$SANDBOX_WORKER_PID_FILE"))"
    else
        echo "sandbox-worker: stopped"
    fi

}

