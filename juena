#!/usr/bin/env bash
#
# JüNA development shortcuts.
#
# These wrap the commands already documented in README.md, HOW-TO-ADD-REPO.md
# and SAML-IFFLOGIN.md -- nothing here does anything those files do not.
# Production deployment deliberately has only a config check and an explicit
# `prod-up`, so a stray `juena` in the wrong directory cannot deploy.
#
# Run `juena help` for the command list, `juena install` to put it on PATH.

set -euo pipefail

# Every command runs against the repository this script lives in, not the
# current directory -- that is what makes `juena up` safe to type from
# anywhere once the script is on PATH.
#
# Symlinks must be followed first: `juena install` links this into ~/.local/bin,
# and BASH_SOURCE then reports the link, not the repo. `readlink -f` is GNU-only,
# so walk the chain by hand to stay portable to macOS.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    link_target="$(readlink "$SCRIPT_PATH")"
    case "$link_target" in
        /*) SCRIPT_PATH="$link_target" ;;
        *)  SCRIPT_PATH="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)/$link_target" ;;
    esac
done
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
cd "$REPO_ROOT"

# Development always loads the base file plus the dev overlay. The overlay is
# opt-in by design: it supplies localhost SAML URLs and an insecure cookie, and
# must never be merged into a production run.
COMPOSE_DEV=(docker compose -f docker-compose.yml -f docker-compose.dev.yml)
COMPOSE_PROD=(docker compose -f docker-compose.yml)

# Production reads its settings from a file outside the repo.
PROD_ENV_FILE="${PROD_ENV_FILE:-/etc/juena/juena.env}"

# Host-side DSN for the integration tests. Matches the development defaults in
# env.example; override in the environment if you changed them.
POSTGRES_USER="${POSTGRES_USER:-juena}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-juena-development-only}"
POSTGRES_DB="${POSTGRES_DB:-juena}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
TEST_DATABASE_URL_OVERRIDE="${TEST_DATABASE_URL:-}"

API_PORT="${API_PORT:-8080}"
UI_PORT="${UI_PORT:-9501}"

POSTGRES_VOLUME="juena-chatbot-postgres"
SANDBOX_RUNTIME_DIR="${SANDBOX_RUNTIME_DIR:-$REPO_ROOT/.sandbox}"
SANDBOX_WORKER_PID_FILE="$SANDBOX_RUNTIME_DIR/worker.pid"
SANDBOX_WORKER_LOG_FILE="$SANDBOX_RUNTIME_DIR/worker.log"

if [ -t 1 ]; then CYAN=$'\033[36m'; DIM=$'\033[2m'; RESET=$'\033[0m'
else CYAN=""; DIM=""; RESET=""; fi

die() { echo "error: $*" >&2; exit 1; }

# Compose auto-loads .env from the repository root, and the base file *requires*
# POSTGRES_PASSWORD. Failing here with a readable message beats failing inside
# compose interpolation.
require_env() {
    [ -f .env ] || die ".env is missing. Run 'juena env' first."
    configure_development_environment
}

dotenv_value() {
    local key="$1"
    awk -v key="$key" 'index($0, key "=") == 1 {sub(/^[^=]*=/, ""); print; exit}' .env
}

environment_value() {
    local key="$1"
    local fallback="$2"
    local value="${!key:-}"
    [ -n "$value" ] || value="$(dotenv_value "$key")"
    printf '%s\n' "${value:-$fallback}"
}

configure_development_environment() {
    export POSTGRES_USER="$(environment_value POSTGRES_USER juena)"
    export POSTGRES_PASSWORD="$(environment_value POSTGRES_PASSWORD juena-development-only)"
    export POSTGRES_DB="$(environment_value POSTGRES_DB juena)"
    export POSTGRES_PORT="$(environment_value POSTGRES_PORT 5432)"
    export SANDBOX_IDENTITY_SECRET="$(environment_value SANDBOX_IDENTITY_SECRET juena-local-sandbox-identity-secret-development)"
    export SANDBOX_WORKSPACE_HOST_ROOT="$(environment_value SANDBOX_WORKSPACE_HOST_ROOT ./.sandbox/workspaces)"
    export SANDBOX_CONCURRENCY="$(environment_value SANDBOX_CONCURRENCY 2)"
    export SANDBOX_WORKER_DATABASE_URL="$(environment_value SANDBOX_WORKER_DATABASE_URL "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}")"
    TEST_DATABASE_URL="${TEST_DATABASE_URL_OVERRIDE:-postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}}"
}

# ---------------------------------------------------------------------------
# Prerequisites
# ---------------------------------------------------------------------------

cmd_env() { ## Create .env from env.example if it does not exist
    if [ -f .env ]; then
        echo ".env already exists; leaving it alone"
    else
        cp env.example .env
        echo "Created .env from env.example -- add at least one LLM provider key"
    fi
}

# ---------------------------------------------------------------------------
# Running natively (uv)
# ---------------------------------------------------------------------------

cmd_run() { ## Run FastAPI natively on :8080 (bootstraps repositories first)
    uv run main.py "$@"
}

cmd_ui() { ## Run the Streamlit UI natively on :9501
    uv run streamlit run app/streamlit_app.py \
        --server.port="$UI_PORT" \
        --server.address=0.0.0.0 "$@"
}

sandbox_podman_uri() { ## Resolve the Podman API socket for this host
    # On macOS Podman runs inside a virtual machine, so its socket is not at the
    # standard Linux path; ask the machine where it published one. `podman info`
    # already reports the right path on both platforms when it is available.
    local socket
    socket="$(podman info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null)"
    if [ "$(uname -s)" = "Darwin" ]; then
        socket="$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null)"
    fi
    [ -n "$socket" ] || return 1
    case "$socket" in
        unix://*) printf '%s\n' "$socket" ;;
        *) printf 'unix://%s\n' "$socket" ;;
    esac
}

configure_sandbox() {
    local workspace_root
    command -v podman >/dev/null 2>&1 || die "Podman is required for sandbox execution."
    if ! podman info >/dev/null 2>&1; then
        if [ "$(uname -s)" = "Darwin" ]; then
            echo "Starting the rootless Podman machine..."
            podman machine start >/dev/null
        else
            die "Rootless Podman is unavailable for the current user."
        fi
    fi
    podman info >/dev/null 2>&1 || die "Rootless Podman did not become ready."

    export SANDBOX_PODMAN_URI="${SANDBOX_PODMAN_URI:-$(sandbox_podman_uri)}"
    [ -n "$SANDBOX_PODMAN_URI" ] || die "Could not determine the Podman socket path."
    export SANDBOX_IMAGE="${SANDBOX_IMAGE:-juena-sandbox:latest}"
    workspace_root="${SANDBOX_WORKSPACE_HOST_ROOT:-$(dotenv_value SANDBOX_WORKSPACE_HOST_ROOT)}"
    workspace_root="${workspace_root:-$SANDBOX_RUNTIME_DIR/workspaces}"
    case "$workspace_root" in
        /*) export SANDBOX_WORKSPACE_ROOT="$workspace_root" ;;
        *) export SANDBOX_WORKSPACE_ROOT="$REPO_ROOT/$workspace_root" ;;
    esac
    export DATABASE_URL="${SANDBOX_WORKER_DATABASE_URL:-$(dotenv_value SANDBOX_WORKER_DATABASE_URL)}"
    export SANDBOX_CPU_LIMIT="${SANDBOX_CPU_LIMIT:-1}"
    export SANDBOX_MEMORY_LIMIT="${SANDBOX_MEMORY_LIMIT:-2g}"
    [ -n "$DATABASE_URL" ] || die "SANDBOX_WORKER_DATABASE_URL is missing from .env"
    mkdir -p "$SANDBOX_WORKSPACE_ROOT"
    # setgid so that files JüNA writes as root still inherit the worker's group,
    # which is what lets the worker and the sandbox container manage them.
    chmod 2770 "$SANDBOX_WORKSPACE_ROOT"
}

worker_is_running() {
    [ -f "$SANDBOX_WORKER_PID_FILE" ] || return 1
    local pid
    read -r pid < "$SANDBOX_WORKER_PID_FILE" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

start_sandbox_worker() {
    mkdir -p "$SANDBOX_RUNTIME_DIR"
    if worker_is_running; then
        return
    fi
    rm -f "$SANDBOX_WORKER_PID_FILE"

    PYTHONDONTWRITEBYTECODE=1 nohup uv run python -m juena.sandbox.worker \
        >"$SANDBOX_WORKER_LOG_FILE" 2>&1 &
    echo "$!" > "$SANDBOX_WORKER_PID_FILE"

    local attempt
    for attempt in {1..30}; do
        if worker_is_running; then
            sleep 1
            worker_is_running || break
            return
        fi
        sleep 0.1
    done
    tail -n 30 "$SANDBOX_WORKER_LOG_FILE" >&2 || true
    die "sandbox worker failed to start; see $SANDBOX_WORKER_LOG_FILE"
}

stop_sandbox_worker() {
    if ! worker_is_running; then
        rm -f "$SANDBOX_WORKER_PID_FILE"
        return
    fi
    local pid
    read -r pid < "$SANDBOX_WORKER_PID_FILE"
    kill "$pid"
    local attempt
    for attempt in {1..50}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && die "sandbox worker did not stop (pid $pid)"
    rm -f "$SANDBOX_WORKER_PID_FILE"
}

prepare_sandbox() {
    configure_sandbox
    podman build -t "$SANDBOX_IMAGE" -f deploy/sandbox/Dockerfile .
}

wait_for_sandbox_stack() {
    local attempt
    for attempt in {1..90}; do
        if "${COMPOSE_DEV[@]}" exec -T postgres psql \
            -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc \
            "SELECT to_regclass('public.sandbox_jobs') IS NOT NULL" 2>/dev/null \
            | grep -qx t \
            && "${COMPOSE_DEV[@]}" exec -T juena-chatbot curl -fsS \
            http://127.0.0.1:8080/health >/dev/null 2>&1; then
            return
        fi
        sleep 1
    done
    die "JüNA or the sandbox_jobs table did not become ready; inspect 'juena logs'"
}

cmd_sandbox_stop() { ## Stop JüNA and the worker but leave PostgreSQL running
    require_env
    stop_sandbox_worker
    "${COMPOSE_DEV[@]}" stop juena-chatbot
    echo "JüNA and the sandbox worker stopped. PostgreSQL is still running."
    echo "Use 'juena postgres-down' to stop PostgreSQL too."
}

cmd_bootstrap() { ## Clone/refresh repositories and rebuild stale vector indices
    uv run python -m juena.indexing.bootstrap "$@"
}

# ---------------------------------------------------------------------------
# Development Postgres
# ---------------------------------------------------------------------------

cmd_postgres_up() { ## Start only Postgres, published on :5432
    require_env
    "${COMPOSE_DEV[@]}" up -d postgres
}

cmd_postgres_down() { ## Stop Postgres, keeping its data volume
    require_env
    "${COMPOSE_DEV[@]}" stop postgres
}

cmd_postgres_reset() { ## DESTROYS development Postgres data. Needs --confirm
    require_env
    local confirmed="${CONFIRM:-}"
    case "${1:-}" in --confirm|-y|yes) confirmed=yes ;; esac
    if [ "$confirmed" != "yes" ]; then
        echo "refusing: this deletes the ${POSTGRES_VOLUME} volume and every" >&2
        echo "development user, chat, checkpoint and memory in it." >&2
        echo "Re-run with: juena postgres-reset --confirm" >&2
        exit 1
    fi
    "${COMPOSE_DEV[@]}" down
    docker volume rm "$POSTGRES_VOLUME"
}

# ---------------------------------------------------------------------------
# Development stack
# ---------------------------------------------------------------------------

cmd_up() { ## Start the full development stack (build if needed)
    require_env
    prepare_sandbox
    "${COMPOSE_DEV[@]}" up --build -d --remove-orphans "$@"
    wait_for_sandbox_stack
    start_sandbox_worker
    echo "UI      http://localhost:${UI_PORT}"
    echo "API     http://localhost:${API_PORT}"
    echo "Worker  $SANDBOX_WORKER_LOG_FILE"
}

cmd_down() { ## Stop the development stack, keeping volumes
    require_env
    stop_sandbox_worker
    "${COMPOSE_DEV[@]}" down "$@"
}

cmd_build() { ## Rebuild the image without starting anything
    require_env
    "${COMPOSE_DEV[@]}" build "$@"
}

cmd_logs() { ## Follow application logs (bootstrap progress appears here)
    require_env
    if [ -f "$SANDBOX_WORKER_LOG_FILE" ]; then
        echo "Recent sandbox worker log ($SANDBOX_WORKER_LOG_FILE):"
        tail -n 30 "$SANDBOX_WORKER_LOG_FILE"
        echo
    fi
    "${COMPOSE_DEV[@]}" logs -f juena-chatbot "$@"
}

cmd_ps() { ## Show development stack status
    require_env
    "${COMPOSE_DEV[@]}" ps "$@"
    if worker_is_running; then
        echo "sandbox-worker: running (pid $(<"$SANDBOX_WORKER_PID_FILE"))"
    else
        echo "sandbox-worker: stopped"
    fi
}

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# `--extra dev` because the test tooling is an optional extra: a bare
# `uv sync` uninstalls pytest, and without this the suite fails to start.
cmd_test() { ## Run the unit suite
    uv run --extra dev pytest -q --ignore=tests/test_postgres_integration.py "$@"
}

cmd_test_integration() { ## Run the Postgres-backed tests against dev Postgres
    cmd_postgres_up
    JUENA_TEST_DATABASE_URL="$TEST_DATABASE_URL" \
        uv run --extra dev pytest tests/test_postgres_integration.py -q "$@"
}

cmd_test_all() { ## Run the unit suite and the Postgres-backed tests
    cmd_test
    cmd_test_integration
}

# ---------------------------------------------------------------------------
# SAML / health
# ---------------------------------------------------------------------------

cmd_health() { ## Check the API health endpoint
    curl -fsS "http://localhost:${API_PORT}/health" && echo
}

cmd_sp_metadata() { ## Print SP metadata (the document to register with the FZJ IdP)
    # Returns 500 while AUTH_DEV_BYPASS is on: the bypass skips saml_lifespan,
    # so no SP is initialised. Unset it to produce real metadata.
    # Redirect to a file to hand it over: juena sp-metadata > sp-metadata.xml
    curl -fsS "http://localhost:${API_PORT}/auth/metadata"
}

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------

cmd_prod_config() { ## Validate the production compose config against PROD_ENV_FILE
    "${COMPOSE_PROD[@]}" --env-file "$PROD_ENV_FILE" config "$@"
}

cmd_prod_up() { ## Start the production stack (base compose file only)
    "${COMPOSE_PROD[@]}" --env-file "$PROD_ENV_FILE" up -d "$@"
}

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

cmd_clean() { ## Remove Python caches, test artefacts, and build output
    # Prune data/ too: cloned repositories carry their own .git and vendored
    # __pycache__ that this should not walk into, let alone delete.
    find . -path ./.venv -prune -o -path ./data -prune -o \
        -type d -name __pycache__ -print0 | xargs -0 rm -rf
    rm -rf .pytest_cache dist build ./*.egg-info
}

cmd_install() { ## Symlink this script into a bin directory on PATH
    local target_dir="${1:-$HOME/.local/bin}"
    mkdir -p "$target_dir"
    ln -sf "$SCRIPT_PATH" "$target_dir/juena"
    echo "linked $target_dir/juena -> $REPO_ROOT/juena"
    case ":$PATH:" in
        *":$target_dir:"*) echo "$target_dir is on PATH; run 'juena help' from anywhere" ;;
        *) echo "note: $target_dir is not on PATH. Add to your shell profile:"
           echo "  export PATH=\"$target_dir:\$PATH\"" ;;
    esac
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# The help text is generated from the `##` comments above, so a new command is
# documented by defining it -- there is no second list to keep in sync.
cmd_help() { ## Show this help
    echo "JüNA development shortcuts"
    echo
    echo "  usage: juena <command> [args...]"
    echo
    # Only the command name gets underscores rewritten -- descriptions may
    # legitimately contain them (PROD_ENV_FILE).
    grep -E '^cmd_[a-z_]+\(\) \{ ## ' "$SCRIPT_PATH" \
        | sed -E 's/^cmd_([a-z_]+)\(\) \{ ## /\1\t/' \
        | awk -F'\t' "{gsub(/_/, \"-\", \$1); printf \"  ${CYAN}%-18s${RESET} %s\n\", \$1, \$2}"
    echo
    echo "  ${DIM}extra args pass through, e.g. 'juena test -k upload'${RESET}"
}

main() {
    local command="${1:-help}"
    shift || true

    # Commands are typed with dashes; the functions use underscores.
    local fn="cmd_${command//-/_}"
    if ! declare -F "$fn" >/dev/null; then
        echo "error: unknown command '$command'" >&2
        echo >&2
        cmd_help >&2
        exit 1
    fi
    "$fn" "$@"
}

main "$@"
