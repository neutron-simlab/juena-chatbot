# Optional source checkout, only for contributors changing core itself.
JUENA_CORE_REPO="${JUENA_CORE_REPO:-$REPO_ROOT/../juena-core}"

cmd_check_imports() { ## Fail if juena-core reached back into an application
    if [ ! -x "$JUENA_CORE_REPO/scripts/check-imports.sh" ]; then
        die "juena-core is not at $JUENA_CORE_REPO; cannot check the import direction. Set JUENA_CORE_REPO."
    fi
    ( cd "$JUENA_CORE_REPO" && ./scripts/check-imports.sh )
}

# `--extra dev` because the test tooling is an optional extra: a bare
# `uv sync` uninstalls pytest, and without this the suite fails to start.
#
# Core's import boundary is checked before publishing its pinned revision.
# Application tests run from this checkout alone; contributors can additionally
# run `juena check-imports` against their core checkout.
cmd_test() { ## Run the unit suite
    uv run --extra dev --extra services pytest -q --ignore=tests/test_postgres_integration.py "$@"
}

cmd_test_integration() { ## Run the Postgres-backed tests against a fresh test database
    cmd_postgres_up
    ensure_test_database
    JUENA_TEST_DATABASE_URL="$TEST_DATABASE_URL" \
        uv run --extra dev pytest tests/test_postgres_integration.py -q "$@"
}

cmd_test_all() { ## Run the unit suite and the Postgres-backed tests
    cmd_test
    cmd_test_integration
}

