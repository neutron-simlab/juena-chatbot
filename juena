#!/usr/bin/env bash
#
# JüNA development shortcuts.
#
# These wrap the commands already documented in README.md, HOW-TO-ADD-REPO.md
# and SAML-IFFLOGIN.md -- nothing here does anything those files do not.
# Production deployment deliberately has only a config check and an explicit
# `prod-up`, so a stray `juena` in the wrong directory cannot deploy.
#
# Run `juena help` for the command list, `juena install` to put it on PATH.

set -euo pipefail

# Every command runs against the repository this script lives in, not the
# current directory -- that is what makes `juena up` safe to type from
# anywhere once the script is on PATH.
#
# Symlinks must be followed first: `juena install` links this into ~/.local/bin,
# and BASH_SOURCE then reports the link, not the repo. `readlink -f` is GNU-only,
# so walk the chain by hand to stay portable to macOS.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    link_target="$(readlink "$SCRIPT_PATH")"
    case "$link_target" in
        /*) SCRIPT_PATH="$link_target" ;;
        *)  SCRIPT_PATH="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)/$link_target" ;;
    esac
done
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
cd "$REPO_ROOT"

# Development always loads the base file plus the dev overlay. The overlay is
# opt-in by design: it supplies localhost SAML URLs and an insecure cookie, and
# must never be merged into a production run.
COMPOSE_DEV=(docker compose -f docker-compose.yml -f docker-compose.dev.yml)
COMPOSE_PROD=(docker compose -f docker-compose.yml)

# Production reads its settings from a file outside the repo.
PROD_ENV_FILE="${PROD_ENV_FILE:-/etc/juena/juena.env}"

# Host-side DSN for the integration tests. Matches the development defaults in
# env.example; override in the environment if you changed them. The integration
# suite gets its own database on the same server -- see `ensure_test_database`.
POSTGRES_USER="${POSTGRES_USER:-juena}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-juena-development-only}"
POSTGRES_DB="${POSTGRES_DB:-juena}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
TEST_DATABASE_URL_OVERRIDE="${TEST_DATABASE_URL:-}"

API_PORT="${API_PORT:-8080}"
UI_PORT="${UI_PORT:-9501}"

POSTGRES_VOLUME="juena-chatbot-postgres"

# Where this script keeps the pids and logs of the processes it starts on the
# host rather than in Compose. Named `.sandbox` because the sandbox worker was
# the first of them; juena-rag is the second.
SANDBOX_RUNTIME_DIR="${SANDBOX_RUNTIME_DIR:-$REPO_ROOT/.sandbox}"
SANDBOX_WORKER_PID_FILE="$SANDBOX_RUNTIME_DIR/worker.pid"
SANDBOX_WORKER_LOG_FILE="$SANDBOX_RUNTIME_DIR/worker.log"
RAG_PID_FILE="$SANDBOX_RUNTIME_DIR/juena-rag.pid"
RAG_LOG_FILE="$SANDBOX_RUNTIME_DIR/juena-rag.log"

# juena-rag is a separate repository holding the vectors, and it runs on the
# *host* -- not in this stack -- which is why JUENA_RAG_URL names
# `host.docker.internal` and not a Compose service. Assumed to sit beside this
# repository; set JUENA_RAG_REPO if you keep it somewhere else.
JUENA_RAG_REPO="${JUENA_RAG_REPO:-$(cd -- "$REPO_ROOT/.." && pwd)/juena-rag}"

# Which address the service listens on. Loopback by default: it is an
# unauthenticated search API over the whole corpus and does not belong on the
# office network. Docker Desktop forwards `host.docker.internal` to the host's
# loopback, so containers reach it anyway; a Linux host routes through the
# bridge instead and needs JUENA_RAG_BIND=0.0.0.0. `juena rag-up` checks which
# of the two you have rather than leaving you to find out from a chat that
# returns no sources.
JUENA_RAG_BIND="${JUENA_RAG_BIND:-127.0.0.1}"

if [ -t 1 ]; then CYAN=$'\033[36m'; DIM=$'\033[2m'; RESET=$'\033[0m'
else CYAN=""; DIM=""; RESET=""; fi

die() { echo "error: $*" >&2; exit 1; }

# Compose auto-loads .env from the repository root, and the base file *requires*
# POSTGRES_PASSWORD. Failing here with a readable message beats failing inside
# compose interpolation.
require_env() {
    [ -f .env ] || die ".env is missing. Run 'juena env' first."
    configure_development_environment
}

dotenv_value() {
    local key="$1"
    awk -v key="$key" 'index($0, key "=") == 1 {sub(/^[^=]*=/, ""); print; exit}' .env
}

environment_value() {
    local key="$1"
    local fallback="$2"
    local value="${!key:-}"
    [ -n "$value" ] || value="$(dotenv_value "$key")"
    printf '%s\n' "${value:-$fallback}"
}

# Accept a known-good shape, reject everything else. Used on any identifier that
# reaches SQL or a Compose environment, and deliberately not an escaping routine:
# an embedded double quote would break out of a quoted identifier, and PostgreSQL
# silently truncates identifiers past 63 bytes, so a long name can resolve to some
# *other* existing database.
_valid_pg_identifier() {
    local value="$1"
    [ -n "$value" ] || return 1
    [ "${#value}" -le 63 ] || return 1
    case "$value" in
        [A-Za-z_]*) ;;
        *) return 1 ;;
    esac
    case "$value" in
        *[!A-Za-z0-9_]*) return 1 ;;
    esac
    return 0
}

configure_development_environment() {
    export POSTGRES_USER="$(environment_value POSTGRES_USER juena)"
    export POSTGRES_PASSWORD="$(environment_value POSTGRES_PASSWORD juena-development-only)"
    export POSTGRES_DB="$(environment_value POSTGRES_DB juena)"
    export POSTGRES_PORT="$(environment_value POSTGRES_PORT 5432)"

    # Validated here, before any Compose command can run. These two reach both SQL
    # and the container environment, and a malformed POSTGRES_DB used to perturb
    # the running stack -- Compose sees a changed variable and recreates Postgres --
    # long before the check beside `DROP DATABASE` ever executed.
    _valid_pg_identifier "$POSTGRES_DB" \
        || die "POSTGRES_DB '$POSTGRES_DB' is not a plain identifier of 63 bytes or fewer."
    _valid_pg_identifier "$POSTGRES_USER" \
        || die "POSTGRES_USER '$POSTGRES_USER' is not a plain identifier of 63 bytes or fewer."
    export SANDBOX_IDENTITY_SECRET="$(environment_value SANDBOX_IDENTITY_SECRET juena-local-sandbox-identity-secret-development)"
    export SANDBOX_WORKSPACE_HOST_ROOT="$(environment_value SANDBOX_WORKSPACE_HOST_ROOT ./.sandbox/workspaces)"
    export SANDBOX_CONCURRENCY="$(environment_value SANDBOX_CONCURRENCY 2)"
    export SANDBOX_WORKER_DATABASE_URL="$(environment_value SANDBOX_WORKER_DATABASE_URL "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}")"
    if [ -n "$TEST_DATABASE_URL_OVERRIDE" ]; then
        # Someone else's database. Used as given, never created or dropped.
        TEST_DATABASE_URL="$TEST_DATABASE_URL_OVERRIDE"
        TEST_DATABASE_NAME=""
    else
        TEST_DATABASE_NAME="${POSTGRES_DB}_test"
        TEST_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${TEST_DATABASE_NAME}"
    fi
}

# The integration suite shares a Postgres server with development, but not a
# database. Test rows used to land in the development database, where 93 of them
# sat among four real research jobs and made every operational query about the
# running system misleading.
#
# Dropped and recreated per run rather than truncated: `database_lifespan` calls
# `create_all` on connect, so an empty database is all the suite needs -- and a
# fresh one cannot inherit a stale schema, which is the failure mode described in
# DOCS/OPENSHIFT/SCHEMA-MIGRATION.md.
#
# Only the derived database is managed here. A TEST_DATABASE_URL supplied by the
# caller names a database this script does not own; dropping it would be a
# destructive surprise.
#
# **One run at a time.** Every default invocation owns the same `<db>_test`, and
# `DROP ... WITH (FORCE)` terminates open connections -- so a second concurrent
# `juena test-integration` would kill the first one's database mid-suite. Set
# TEST_DATABASE_URL to a distinct database if you need runs in parallel.

ensure_test_database() {
    if [ -z "$TEST_DATABASE_NAME" ]; then
        echo "${DIM}Using TEST_DATABASE_URL from the environment; not creating or resetting it.${RESET}"
        return 0
    fi

    # Defence in depth. POSTGRES_DB was already validated at load time, but the
    # name dropped here is *derived* from it -- a POSTGRES_DB of exactly 63 bytes
    # passes that check and yields a 68-byte `<db>_test` that PostgreSQL would
    # silently truncate. The derived name gets its own check for that reason.
    _valid_pg_identifier "$TEST_DATABASE_NAME" \
        || die "Refusing to drop '$TEST_DATABASE_NAME': not a plain identifier of 63 bytes or fewer. Check POSTGRES_DB."
    case "$TEST_DATABASE_NAME" in
        *_test) ;;
        *) die "Refusing to drop '$TEST_DATABASE_NAME': the managed test database must end in _test." ;;
    esac
    [ "$TEST_DATABASE_NAME" != "$POSTGRES_DB" ] \
        || die "Refusing to drop '$TEST_DATABASE_NAME': it is the development database."

    local attempt=0
    until "${COMPOSE_DEV[@]}" exec -T postgres pg_isready -U "$POSTGRES_USER" -q >/dev/null 2>&1; do
        attempt=$((attempt + 1))
        [ "$attempt" -lt 30 ] || die "Postgres did not become ready for the test database"
        sleep 1
    done

    "${COMPOSE_DEV[@]}" exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
        -v ON_ERROR_STOP=1 -q \
        -c "DROP DATABASE IF EXISTS \"$TEST_DATABASE_NAME\" WITH (FORCE)" \
        -c "CREATE DATABASE \"$TEST_DATABASE_NAME\" OWNER \"$POSTGRES_USER\"" \
        || die "Could not reset the test database '$TEST_DATABASE_NAME'"
    echo "${DIM}Integration tests will run against a fresh '${TEST_DATABASE_NAME}'.${RESET}"
}

# ---------------------------------------------------------------------------
# Prerequisites
# ---------------------------------------------------------------------------

cmd_env() { ## Create .env from env.example if it does not exist
    if [ -f .env ]; then
        echo ".env already exists; leaving it alone"
    else
        cp env.example .env
        echo "Created .env from env.example -- add at least one LLM provider key"
    fi
}

# ---------------------------------------------------------------------------
# Running natively (uv)
# ---------------------------------------------------------------------------

cmd_run() { ## Run FastAPI natively on :8080 (bootstraps repositories first)
    uv run main.py "$@"
}

cmd_ui() { ## Run the Streamlit UI natively on :9501
    uv run streamlit run app/streamlit_app.py \
        --server.port="$UI_PORT" \
        --server.address=0.0.0.0 "$@"
}

sandbox_podman_uri() { ## Resolve the Podman API socket for this host
    # On macOS Podman runs inside a virtual machine, so its socket is not at the
    # standard Linux path; ask the machine where it published one. `podman info`
    # already reports the right path on both platforms when it is available.
    local socket
    socket="$(podman info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null)"
    if [ "$(uname -s)" = "Darwin" ]; then
        socket="$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null)"
    fi
    [ -n "$socket" ] || return 1
    case "$socket" in
        unix://*) printf '%s\n' "$socket" ;;
        *) printf 'unix://%s\n' "$socket" ;;
    esac
}

configure_sandbox() {
    local workspace_root
    command -v podman >/dev/null 2>&1 || die "Podman is required for sandbox execution."
    if ! podman info >/dev/null 2>&1; then
        if [ "$(uname -s)" = "Darwin" ]; then
            echo "Starting the rootless Podman machine..."
            podman machine start >/dev/null
        else
            die "Rootless Podman is unavailable for the current user."
        fi
    fi
    podman info >/dev/null 2>&1 || die "Rootless Podman did not become ready."

    export SANDBOX_PODMAN_URI="${SANDBOX_PODMAN_URI:-$(sandbox_podman_uri)}"
    [ -n "$SANDBOX_PODMAN_URI" ] || die "Could not determine the Podman socket path."
    export SANDBOX_IMAGE="${SANDBOX_IMAGE:-juena-sandbox:latest}"
    workspace_root="${SANDBOX_WORKSPACE_HOST_ROOT:-$(dotenv_value SANDBOX_WORKSPACE_HOST_ROOT)}"
    workspace_root="${workspace_root:-$SANDBOX_RUNTIME_DIR/workspaces}"
    case "$workspace_root" in
        /*) export SANDBOX_WORKSPACE_ROOT="$workspace_root" ;;
        *) export SANDBOX_WORKSPACE_ROOT="$REPO_ROOT/$workspace_root" ;;
    esac
    export DATABASE_URL="${SANDBOX_WORKER_DATABASE_URL:-$(dotenv_value SANDBOX_WORKER_DATABASE_URL)}"
    # Export one set for both consumers: Compose passes these to the API, and
    # the host worker inherits them below. An approval card must describe the
    # limits the worker will actually enforce.
    export SANDBOX_CPU_LIMIT="$(environment_value SANDBOX_CPU_LIMIT 1)"
    export SANDBOX_MEMORY_LIMIT="$(environment_value SANDBOX_MEMORY_LIMIT 2g)"
    export SANDBOX_WORKSPACE_LIMIT_BYTES="$(environment_value SANDBOX_WORKSPACE_LIMIT_BYTES 5368709120)"
    export SANDBOX_IDLE_TTL_SECONDS="$(environment_value SANDBOX_IDLE_TTL_SECONDS 86400)"
    [ -n "$DATABASE_URL" ] || die "SANDBOX_WORKER_DATABASE_URL is missing from .env"
    mkdir -p "$SANDBOX_WORKSPACE_ROOT"
    # setgid so that files JüNA writes as root still inherit the worker's group,
    # which is what lets the worker and the sandbox container manage them.
    chmod 2770 "$SANDBOX_WORKSPACE_ROOT"
}

# Both host-side processes are tracked the same way, so the "is it alive" and
# "stop it" rules live here once. A pid file naming a process that has since
# exited reads as stopped, which is what makes a machine that was rebooted
# mid-run recover by simply starting it again.
pid_file_is_running() {
    local pid_file="$1"
    [ -f "$pid_file" ] || return 1
    local pid
    read -r pid < "$pid_file" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

stop_pid_file() {
    local pid_file="$1"
    local name="$2"
    if ! pid_file_is_running "$pid_file"; then
        rm -f "$pid_file"
        return
    fi
    local pid
    read -r pid < "$pid_file"
    kill "$pid"
    local attempt
    for attempt in {1..50}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && die "$name did not stop (pid $pid)"
    rm -f "$pid_file"
}

worker_is_running() { pid_file_is_running "$SANDBOX_WORKER_PID_FILE"; }

start_sandbox_worker() {
    mkdir -p "$SANDBOX_RUNTIME_DIR"
    if worker_is_running; then
        return
    fi
    rm -f "$SANDBOX_WORKER_PID_FILE"

    PYTHONDONTWRITEBYTECODE=1 nohup uv run python -m juena_core.sandbox.worker \
        >"$SANDBOX_WORKER_LOG_FILE" 2>&1 &
    echo "$!" > "$SANDBOX_WORKER_PID_FILE"

    local attempt
    for attempt in {1..30}; do
        if worker_is_running; then
            sleep 1
            worker_is_running || break
            return
        fi
        sleep 0.1
    done
    tail -n 30 "$SANDBOX_WORKER_LOG_FILE" >&2 || true
    die "sandbox worker failed to start; see $SANDBOX_WORKER_LOG_FILE"
}

stop_sandbox_worker() {
    stop_pid_file "$SANDBOX_WORKER_PID_FILE" "sandbox worker"
}

prepare_sandbox() {
    configure_sandbox
    podman build -t "$SANDBOX_IMAGE" -f deploy/sandbox/Dockerfile .
}

verify_sandbox_limits_agree() {
    # The API puts these numbers on the approval card and admits jobs against
    # them; the host worker is what Podman actually enforces. They are one
    # exported set, so a difference here means a value stopped being passed
    # through -- which is exactly how the card came to promise 2 vCPU / 4 GB
    # while the worker ran 1 vCPU / 2 GB, silently, for as long as nobody
    # compared them.
    local key api worker mismatch=0
    for key in SANDBOX_CPU_LIMIT SANDBOX_MEMORY_LIMIT \
               SANDBOX_WORKSPACE_LIMIT_BYTES SANDBOX_IDLE_TTL_SECONDS; do
        # `exec` into a restarting container prints nothing and still exits 0,
        # so an empty answer is reported as unreadable rather than as a value.
        # Both being empty must never read as agreement.
        api="$("${COMPOSE_DEV[@]}" exec -T juena-chatbot printenv "$key" 2>/dev/null | tr -d '\r')"
        worker="${!key:-}"
        if [ -z "$api" ]; then
            echo "  $key: unreadable in the API container (is it running?), worker '$worker'" >&2
            mismatch=1
        elif [ "$api" != "$worker" ]; then
            echo "  $key: API '$api', worker '$worker'" >&2
            mismatch=1
        fi
    done
    [ "$mismatch" -eq 0 ] || die "sandbox limits disagree between the API and the worker (see above). The API takes them from docker-compose.yml, the worker from this script's exports; both read the same variables."
}

wait_for_sandbox_stack() {
    local attempt
    for attempt in {1..90}; do
        if "${COMPOSE_DEV[@]}" exec -T postgres psql \
            -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc \
            "SELECT to_regclass('public.sandbox_jobs') IS NOT NULL" 2>/dev/null \
            | grep -qx t \
            && "${COMPOSE_DEV[@]}" exec -T juena-chatbot curl -fsS \
            http://127.0.0.1:8080/health >/dev/null 2>&1; then
            return
        fi
        sleep 1
    done
    die "JüNA or the sandbox_jobs table did not become ready; inspect 'juena logs'"
}

cmd_sandbox_stop() { ## Stop JüNA and the worker but leave PostgreSQL running
    require_env
    stop_sandbox_worker
    "${COMPOSE_DEV[@]}" stop juena-chatbot
    echo "JüNA and the sandbox worker stopped. PostgreSQL is still running."
    echo "Use 'juena postgres-down' to stop PostgreSQL too."
}

cmd_bootstrap() { ## Clone/refresh repositories and rebuild stale vector indices
    uv run python -m juena.indexing.bootstrap "$@"
}

# ---------------------------------------------------------------------------
# Development Postgres
# ---------------------------------------------------------------------------

cmd_postgres_up() { ## Start only Postgres, published on :5432
    require_env
    "${COMPOSE_DEV[@]}" up -d postgres
}

cmd_postgres_down() { ## Stop Postgres, keeping its data volume
    require_env
    "${COMPOSE_DEV[@]}" stop postgres
}

cmd_postgres_reset() { ## DESTROYS development Postgres data. Needs --confirm
    require_env
    local confirmed="${CONFIRM:-}"
    case "${1:-}" in --confirm|-y|yes) confirmed=yes ;; esac
    if [ "$confirmed" != "yes" ]; then
        echo "refusing: this deletes the ${POSTGRES_VOLUME} volume and every" >&2
        echo "development user, chat, checkpoint and memory in it." >&2
        echo "Re-run with: juena postgres-reset --confirm" >&2
        exit 1
    fi
    "${COMPOSE_DEV[@]}" down
    docker volume rm "$POSTGRES_VOLUME"
}

# ---------------------------------------------------------------------------
# juena-rag, the search backend
# ---------------------------------------------------------------------------
#
# Repository search is served by juena-rag and by nothing else -- the local
# Chroma index was deleted in the cutover, so there is no fallback and a stack
# started without this answers every repository question with no sources. It is
# started here, before the stack, so the chatbot's startup survey finds it.

# One source of truth for the port: the URL the containers are already told to
# use. Only the port is reused -- the host part of that URL is
# `host.docker.internal`, which means nothing outside a container.
rag_port() {
    local url port
    url="$(environment_value JUENA_RAG_URL "")"
    url="${url%/}"
    port="${url##*:}"
    case "$port" in
        ''|*[!0-9]*) printf '8100\n' ;;
        *) printf '%s\n' "$port" ;;
    esac
}

rag_is_running() { pid_file_is_running "$RAG_PID_FILE"; }

# Anything that runs inside the juena-rag repository goes through here, because
# of one trap: `configure_development_environment` exports this repository's
# POSTGRES_* values, and juena-rag builds its own DSN out of variables by those
# same names. Inherited, they would aim the service at the chatbot's database on
# :5432 instead of the corpus on :5433 -- and start a second pgvector on a port
# already taken. VIRTUAL_ENV goes for the same reason: uv warns and ignores it,
# but the warning is the only sign anything was wrong.
rag_repo_env() {
    cd "$JUENA_RAG_REPO"
    unset POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DB POSTGRES_PORT VIRTUAL_ENV
    # Sourced rather than read key-by-key: juena-rag's DSN is written in terms of
    # ${POSTGRES_USER} and friends and has to be expanded, not copied literally.
    set -a
    # shellcheck disable=SC1091
    . ./.env
    set +a
}

require_rag_repo() {
    [ -d "$JUENA_RAG_REPO" ] \
        || die "juena-rag is not at $JUENA_RAG_REPO. Clone it beside this repository, or set JUENA_RAG_REPO."
    [ -f "$JUENA_RAG_REPO/.env" ] \
        || die "$JUENA_RAG_REPO/.env is missing. Copy .env.example there -- the service needs JUENA_RAG_DSN and a Blablador key."
}

start_rag_service() {
    local port="$1"
    mkdir -p "$SANDBOX_RUNTIME_DIR"
    rm -f "$RAG_PID_FILE"
    (
        rag_repo_env
        nohup uv run juena-rag serve --host "$JUENA_RAG_BIND" --port "$port" \
            >"$RAG_LOG_FILE" 2>&1 &
        echo "$!" > "$RAG_PID_FILE"
    )
}

# Generous, because startup is not just a socket opening: the service embeds one
# probe string against Blablador to check the configured vector width is real,
# and that is a round trip to Jülich before it will listen.
wait_for_rag() {
    local port="$1"
    local attempt
    for attempt in {1..60}; do
        if curl -fsS -m 3 "http://127.0.0.1:${port}/v1/health" >/dev/null 2>&1; then
            return
        fi
        rag_is_running || break
        sleep 1
    done
    tail -n 30 "$RAG_LOG_FILE" >&2 || true
    die "juena-rag did not become healthy; see $RAG_LOG_FILE"
}

# The check that actually matters, and the one whose absence hid a broken stack:
# the chatbot reaches juena-rag from inside a container over JUENA_RAG_URL, not
# over loopback. A service bound to 127.0.0.1 answers `wait_for_rag` on a Linux
# host and is still unreachable from the container.
#
# Safe to call whenever: it says nothing unless there is really a service on the
# host and a container running to reach it, so both `rag-up` (where the stack may
# be down) and `up` (where it has just come up) can call it unconditionally.
report_rag_reachability() {
    local url
    url="$(environment_value JUENA_RAG_URL "")"
    [ -n "$url" ] || return 0
    curl -fsS -m 3 "http://127.0.0.1:$(rag_port)/v1/health" >/dev/null 2>&1 || return 0
    "${COMPOSE_DEV[@]}" ps --status running --services 2>/dev/null \
        | grep -qx juena-chatbot || return 0

    if "${COMPOSE_DEV[@]}" exec -T juena-chatbot \
        curl -fsS -m 5 "${url%/}/v1/health" >/dev/null 2>&1; then
        echo "${DIM}The stack reaches juena-rag at ${url}.${RESET}"
    else
        echo "warning: juena-rag answers on the host, but the juena-chatbot" >&2
        echo "         container cannot reach $url -- repository search will" >&2
        echo "         return no sources. If this is a Linux host, bind past" >&2
        echo "         loopback:  JUENA_RAG_BIND=0.0.0.0 juena rag-up" >&2
    fi
}

cmd_rag_up() { ## Start juena-rag and its pgvector database on the host
    require_env
    require_rag_repo
    local port
    port="$(rag_port)"

    # The database first: the service opens its connection pool during startup
    # and exits if pgvector is not there yet.
    ( rag_repo_env && docker compose up -d --wait pgvector ) \
        || die "juena-rag's pgvector did not start; check $JUENA_RAG_REPO/.env"

    if rag_is_running; then
        echo "juena-rag already running (pid $(<"$RAG_PID_FILE")) on :${port}"
    elif curl -fsS -m 3 "http://127.0.0.1:${port}/v1/health" >/dev/null 2>&1; then
        # Someone started it by hand. Left alone rather than started a second
        # time: the new process would lose the bind and exit, while the health
        # check below went on passing against the one already there.
        echo "juena-rag is already serving :${port}, started outside this script."
        echo "${DIM}'juena rag-down' will not find it; stop that process yourself.${RESET}"
    else
        start_rag_service "$port"
        wait_for_rag "$port"
        echo "juena-rag on http://127.0.0.1:${port} (pid $(<"$RAG_PID_FILE"))"
        echo "${DIM}Log: $RAG_LOG_FILE${RESET}"
    fi
    report_rag_reachability
}

# `rag-up` starts the service and its database together, so stopping puts both
# back. The container is stopped rather than removed, and the corpus lives in a
# named volume either way -- nothing here loses the ingested chunks.
stop_rag_stack() {
    stop_pid_file "$RAG_PID_FILE" "juena-rag"
    [ -d "$JUENA_RAG_REPO" ] && [ -f "$JUENA_RAG_REPO/.env" ] || return 0
    ( rag_repo_env && docker compose stop pgvector ) \
        || echo "warning: could not stop juena-rag's pgvector; stop it in $JUENA_RAG_REPO" >&2
}

cmd_rag_down() { ## Stop juena-rag and its pgvector database
    stop_rag_stack
    echo "juena-rag stopped. The corpus is kept in its volume."
}

cmd_rag_logs() { ## Follow the juena-rag service log
    [ -f "$RAG_LOG_FILE" ] || die "no juena-rag log yet at $RAG_LOG_FILE. Run 'juena rag-up' first."
    tail -f "$RAG_LOG_FILE"
}

# `juena up` must not fail because a sibling repository is missing or its key has
# expired. The chatbot already degrades in exactly this case -- it keeps the
# tools attached and reports the outage per request -- so the stack comes up and
# says what is missing rather than refusing to start.
start_rag_if_available() {
    if [ ! -d "$JUENA_RAG_REPO" ]; then
        echo "warning: juena-rag is not at $JUENA_RAG_REPO, so the stack starts" >&2
        echo "         without repository search. Clone it beside this" >&2
        echo "         repository, or set JUENA_RAG_REPO." >&2
        return 0
    fi
    # A subshell so that a `die` inside stops juena-rag, not `juena up`.
    ( cmd_rag_up ) || {
        echo "warning: juena-rag did not start -- the stack is coming up without" >&2
        echo "         repository search. See $RAG_LOG_FILE, then 'juena rag-up'." >&2
    }
}

# ---------------------------------------------------------------------------
# Development stack
# ---------------------------------------------------------------------------

cmd_up() { ## Start the full development stack (build if needed)
    require_env
    prepare_sandbox
    # Before the stack, not after: the chatbot surveys the corpus as it builds
    # the agent, and a juena-rag that arrives late means a startup logged as
    # degraded.
    start_rag_if_available
    "${COMPOSE_DEV[@]}" up --build -d --remove-orphans "$@"
    wait_for_sandbox_stack
    start_sandbox_worker
    # After both exist, because it compares them: what the user is asked to
    # approve against what the sandbox will enforce.
    verify_sandbox_limits_agree
    # Only now is there a container to test from -- `start_rag_if_available` ran
    # before the stack existed, so this is the first point the real path can be
    # checked end to end.
    report_rag_reachability
    echo "UI      http://localhost:${UI_PORT}"
    echo "API     http://localhost:${API_PORT}"
    echo "Search  http://127.0.0.1:$(rag_port) (juena-rag)"
    echo "Worker  $SANDBOX_WORKER_LOG_FILE"
}

cmd_down() { ## Stop the development stack, keeping volumes
    require_env
    stop_sandbox_worker
    # juena-rag comes down with the stack, database included: `up` started it,
    # so `down` is what puts it back. Anything that wants the corpus on its own
    # -- an ingestion run, juena-rag's own test suite -- starts it from that
    # repository and is not this script's business.
    stop_rag_stack
    "${COMPOSE_DEV[@]}" down "$@"
}

cmd_build() { ## Rebuild the image without starting anything
    require_env
    "${COMPOSE_DEV[@]}" build "$@"
}

cmd_logs() { ## Follow application logs (bootstrap progress appears here)
    require_env
    if [ -f "$SANDBOX_WORKER_LOG_FILE" ]; then
        echo "Recent sandbox worker log ($SANDBOX_WORKER_LOG_FILE):"
        tail -n 30 "$SANDBOX_WORKER_LOG_FILE"
        echo
    fi
    "${COMPOSE_DEV[@]}" logs -f juena-chatbot "$@"
}

cmd_ps() { ## Show development stack status
    require_env
    "${COMPOSE_DEV[@]}" ps "$@"
    if worker_is_running; then
        echo "sandbox-worker: running (pid $(<"$SANDBOX_WORKER_PID_FILE"))"
    else
        echo "sandbox-worker: stopped"
    fi
    if rag_is_running; then
        echo "juena-rag:      running (pid $(<"$RAG_PID_FILE")) on :$(rag_port)"
    else
        echo "juena-rag:      stopped -- repository search returns no sources"
    fi
}

