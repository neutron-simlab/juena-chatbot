# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------

configure_production_compose() {
    [ -f "$PROD_ENV_FILE" ] || die "missing server environment: $PROD_ENV_FILE"
    COMPOSE_PROD=(docker compose -f docker-compose.yml --profile server --env-file "$PROD_ENV_FILE")
    # Ask Compose to parse quoting and precedence without sourcing shell code.
    if "${COMPOSE_PROD[@]}" config --environment | grep -qx 'LANGFUSE_TRACING=true'; then
        COMPOSE_PROD+=(-f docker-compose.tracing.yml)
    fi
}

cmd_prod_config() { ## Validate server configuration (use --quiet to avoid printing secrets)
    configure_production_compose
    "${COMPOSE_PROD[@]}" config "$@"
}

cmd_prod_up() { ## Start the server stack and HTTPS gateway
    configure_production_compose
    if "${COMPOSE_PROD[@]}" config --environment | grep -qx 'LANGFUSE_TRACING=true'; then
        ensure_tracing_network
    fi
    "${COMPOSE_PROD[@]}" up -d --build --wait --wait-timeout 900 "$@"
}

cmd_prod_down() { ## Stop the server Compose project, retaining its volumes
    configure_production_compose
    "${COMPOSE_PROD[@]}" down "$@"
}

cmd_prod_repos_ingest() { ## Ingest with the server environment, then re-pin running clones
    configure_production_compose
    COMPOSE_INGEST=("${COMPOSE_PROD[@]}")
    ingest_repositories "$@"
}

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

cmd_clean() { ## Remove Python caches, test artefacts, and build output
    # Prune data/ too: cloned repositories carry their own .git and vendored
    # __pycache__ that this should not walk into, let alone delete.
    find . -path ./.venv -prune -o -path ./data -prune -o \
        -type d -name __pycache__ -print0 | xargs -0 rm -rf
    rm -rf .pytest_cache dist build ./*.egg-info
}

cmd_install() { ## Symlink this script into a bin directory on PATH
    local target_dir="${1:-$HOME/.local/bin}"
    mkdir -p "$target_dir"
    ln -sf "$SCRIPT_PATH" "$target_dir/juena"
    echo "linked $target_dir/juena -> $REPO_ROOT/juena"
    case ":$PATH:" in
        *":$target_dir:"*) echo "$target_dir is on PATH; run 'juena help' from anywhere" ;;
        *) echo "note: $target_dir is not on PATH. Add to your shell profile:"
           echo "  export PATH=\"$target_dir:\$PATH\"" ;;
    esac
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# The help text is generated from the `##` comments above, so a new command is
# documented by defining it -- there is no second list to keep in sync.
cmd_help() { ## Show this help
    echo "JüNA development shortcuts"
    echo
    echo "  usage: juena <command> [args...]"
    echo
    # Only the command name gets underscores rewritten -- descriptions may
    # legitimately contain them (PROD_ENV_FILE).
    grep -E '^cmd_[a-z_]+\(\) \{ ## ' "$SCRIPT_PATH" \
        | sed -E 's/^cmd_([a-z_]+)\(\) \{ ## /\1\t/' \
        | awk -F'\t' "{gsub(/_/, \"-\", \$1); printf \"  ${CYAN}%-18s${RESET} %s\n\", \$1, \$2}"
    echo
    echo "  ${DIM}extra args pass through, e.g. 'juena test -k upload'${RESET}"
}

main() {
    local command="${1:-help}"
    shift || true

    # Commands are typed with dashes; the functions use underscores.
    local fn="cmd_${command//-/_}"
    if ! declare -F "$fn" >/dev/null; then
        echo "error: unknown command '$command'" >&2
        echo >&2
        cmd_help >&2
        exit 1
    fi
    "$fn" "$@"
}

main "$@"
