# JüNA environment configuration
# `juena env` copies this file to .env. For local development the only value
# you must add is your Blablador API key (BLABLADOR_API_KEY below).

# =============================================================================
# REQUIRED: LLM provider configuration
# =============================================================================
# OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key-here
# DEFAULT_PROVIDER=openai
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# OPENAI_AVAILABLE_MODELS=gpt-4o-mini

# Blablador (OpenAI-compatible API) -- the default provider. Until the key is
# filled in, startup stops and says the provider is not configured.
BLABLADOR_API_KEY=
BLABLADOR_BASE_URL=https://api.blablador.fz-juelich.de/v1/
DEFAULT_PROVIDER=blablador
BLABLADOR_DEFAULT_MODEL=90 - Qwen 3.8-Flash-Next-125B-AWQ-W4A16 on Juwels Booster - An excellent model from September 2026
BLABLADOR_EMBEDDING_MODEL=alias-qwen3-8b-embeddings

# Optional invocation-time fallback. It must name a configured provider.
FALLBACK_PROVIDER=blablador

# DEFAULT_MODEL remains accepted for one compatibility release. New
# configurations should use OPENAI_DEFAULT_MODEL or BLABLADOR_DEFAULT_MODEL.

# =============================================================================
# OPTIONAL: model and external-tool settings
# =============================================================================
# Default per-response output limit; this does not set the context window.
# Software and neutron specialists use Qwen3.8-Flash-Next on JUWELS with a
# 940,000-token context and an explicit 32,768-token output allowance. Their
# summarizer uses the same model so longer histories can be retained.
MAX_TOKENS=10000
# Timeout for ordinary UI/API calls and for stream connection/write setup.
# Streaming response reads remain open while the agent is working.
TIMEOUT_SECONDS=60
MAX_RETRIES=3

# Context7 gives software-specialist external library/framework documentation.
# CONTEXT7_API_KEY=your-context7-api-key-here
# CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
# CONTEXT7_TIMEOUT_SECONDS=30

# Tavily gives neutron-research-specialist optional current-web search.
# TAVILY_API_KEY=tvly-your-tavily-api-key-here

# juena-rag, the shared retrieval service. REQUIRED -- repository search has no
# local index to fall back to, so an unset value stops the process rather than
# quietly serving stale results from the retired Chroma index.
#
# The address differs by how you run JueNA, because it is a different machine
# each time:
#   native (`juena run` / `juena ui`)   http://127.0.0.1:8100
#   containers (`juena up`)             http://host.docker.internal:8100
#
# The service itself runs on the host, from the juena-rag repository beside this
# one. `juena up` starts it for you and `juena ps` says whether it is up; on its
# own it is `juena rag-up`. Only the port here is reused -- the launcher binds to
# loopback whatever host this names. If searches come back with no sources, this
# service is the first thing to check.
#
# The repositories are still cloned locally -- search comes over the network, but
# the model opens the real file to quote real line numbers. Startup does this for
# you; by hand it is:
#   python -m juena.indexing.bootstrap
JUENA_RAG_URL=http://host.docker.internal:8100

# =============================================================================
# OPTIONAL: tracing
# =============================================================================
# Two independent switches. With both on, every run is traced to both.
#
# Langfuse runs on this machine: `juena langfuse-up` starts it, and the UI is
# http://localhost:3000 (login in deploy/langfuse/.env). It keeps running when
# you `juena down`. See deploy/LANGFUSE.md.
#
# The address differs by how you run JueNA:
#   native (`juena run`)       http://localhost:3000
#   containers (`juena up`)    http://langfuse:3000   (private Docker network)
#
# The two keys must equal LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY in
# deploy/langfuse/.env; `juena langfuse-check` proves they do. The values here
# are the development pair that file starts with.
LANGFUSE_TRACING=true
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-juena-development-only
LANGFUSE_SECRET_KEY=sk-lf-juena-development-only

# Hosted LangSmith. LANGSMITH_TRACING alone decides: startup overrides any
# LANGSMITH_TRACING_V2 / LANGCHAIN_TRACING_V2 left in the environment.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=juena-chatbot

# =============================================================================
# OPTIONAL: isolated Python and shell execution
# =============================================================================
# On for development: `juena up` starts the host-side rootless-Podman worker
# (the README's setup installs Podman). Set false if you have no Podman.
# Production runs the worker under systemd. The `sandbox_jobs` table is the
# only channel between JüNA and the worker.
SANDBOX_ENABLED=true

# The worker runs on the host, so it reaches Postgres over loopback while JüNA
# reaches it over the Compose network.
SANDBOX_WORKER_DATABASE_URL=postgresql://juena:juena-development-only@127.0.0.1:5432/juena
# Execution slots. JüNA and the worker must agree: JüNA admits this many active
# jobs before reporting the sandbox busy, and the worker runs this many
# containers. Use 2 for development and 4 in production.
SANDBOX_CONCURRENCY=2
# Stable HMAC key for opaque tenant and workspace identifiers. This is the
# launcher's development value; production needs its own random one
# (`openssl rand -hex 32`). Required even with SANDBOX_ENABLED=false; never
# rotate it without migrating the existing conversation workspace identities.
SANDBOX_IDENTITY_SECRET=juena-local-sandbox-identity-secret-development
# Host directory bind-mounted into JüNA and mounted into generated containers
# only through the trusted worker. Files remain available with execution off.
# Keep this path and SANDBOX_IDENTITY_SECRET stable across restarts/upgrades.
SANDBOX_WORKSPACE_HOST_ROOT=./.sandbox/workspaces
# Development-only UI preview. The chip is visible but cannot send an execution
# request until SANDBOX_ENABLED=true. Production rejects this preview-only mode.
SANDBOX_STARTER_PREVIEW=true
# Optional worker overrides. `juena up` resolves the Podman API socket and a
# repository-local ignored workspace automatically. Production worker settings
# belong in its own env file; see deploy/sandbox-worker.env.example.
# SANDBOX_IMAGE=juena-sandbox:latest
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_WORKSPACE_LIMIT_BYTES=5368709120
# Only /workspace/.scratch expires. Other workspace files persist until deletion.
SANDBOX_IDLE_TTL_SECONDS=86400
SANDBOX_EXECUTION_TIMEOUT_SECONDS=600
SANDBOX_MAX_OUTPUT_BYTES=100000
SANDBOX_ARTIFACT_ROOT=/data/artifacts
SANDBOX_AUDIT_FILE=/data/audit/sandbox.jsonl

# =============================================================================
# Server and browser origins
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
UI_PORT=9501

# Private, server-side URL used only by Streamlit when calling FastAPI.
JUENA_API_INTERNAL_URL=http://localhost:8080
# Browser-facing FastAPI/gateway origin used to build login links.
JUENA_PUBLIC_URL=http://localhost:8080
# Compatibility setting for the post-login UI destination. Development uses a
# separate Streamlit port; production should use the same HTTPS gateway origin
# as JUENA_PUBLIC_URL. This alias is retained for one release.
UI_PUBLIC_URL=http://localhost:9501

# =============================================================================
# Environment and Postgres persistence
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=/tmp/logs
# Peak allowance for repository bootstrap and the combined development service.
JUENA_MEMORY_LIMIT=12G

# Credentials for the `postgres` Compose service. The base compose file has NO
# default for POSTGRES_PASSWORD: leave it unset in production and the container
# refuses to initialise, which surfaces minutes later as a health-check timeout
# on a service that looks unrelated. Production must supply a generated value
# and keep DATABASE_URL below in step with it.
POSTGRES_DB=juena
POSTGRES_USER=juena
POSTGRES_PASSWORD=juena-development-only
# Host port for the development Postgres publish (docker-compose.dev.yml only).
# POSTGRES_PORT=5432

# For running JüNA natively on the host (`juena run`), where Postgres is reached
# on localhost. Compose does NOT use this value: it builds the container DSN
# from the POSTGRES_* settings above against the `postgres` service, because a
# localhost DSN inside a container points at the container itself.
DATABASE_URL=postgresql://juena:juena-development-only@localhost:5432/juena
# DATABASE_POOL_MAX_SIZE=20
# How long an issued session cookie stays valid.
# SESSION_TTL_HOURS=8

# =============================================================================
# FZJ SAML2 service provider
# =============================================================================
SAML_IDP_METADATA_URL=https://ifflogin.fz-juelich.de/saml/idp.xml
SAML_SP_ENTITY_ID=http://localhost:8080/auth/metadata
SAML_SP_ACS_URL=http://localhost:8080/auth/acs
SAML_SP_SLS_URL=http://localhost:8080/auth/sls
SAML_SP_CERT_FILE=/data/saml/sp.crt
SAML_SP_KEY_FILE=/data/saml/sp.key
SESSION_COOKIE_SECURE=false

# Production must explicitly provide public HTTPS values. Configuration fails
# closed for missing/non-HTTPS public and SAML URLs or insecure cookies.
# ENVIRONMENT=production
# JUENA_API_INTERNAL_URL=http://localhost:8080
# JUENA_PUBLIC_URL=https://juena.fz-juelich.de
# UI_PUBLIC_URL=https://juena.fz-juelich.de
# SAML_SP_ENTITY_ID=https://juena.fz-juelich.de/auth/metadata
# SAML_SP_ACS_URL=https://juena.fz-juelich.de/auth/acs
# SAML_SP_SLS_URL=https://juena.fz-juelich.de/auth/sls
# SESSION_COOKIE_SECURE=true

# Development-only authentication bypass: sign in locally without FZJ login.
# It is rejected in production.
AUTH_DEV_BYPASS=true

# =============================================================================
# Development settings
# =============================================================================
RELOAD=false
