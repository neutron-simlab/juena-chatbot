# JüNA environment configuration
# Copy this file to .env and configure at least one LLM provider.

# =============================================================================
# REQUIRED: LLM provider configuration
# =============================================================================
# OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key-here
# DEFAULT_PROVIDER=openai
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# OPENAI_AVAILABLE_MODELS=gpt-4o-mini

# Blablador (OpenAI-compatible API)
# BLABLADOR_API_KEY=your-blablador-api-key-here
# BLABLADOR_BASE_URL=https://api.helmholtz-blablador.fz-juelich.de/v1/
# DEFAULT_PROVIDER=blablador
# BLABLADOR_DEFAULT_MODEL=01 - GPT-OSS-120b - an open model released by OpenAI in August 2025
# BLABLADOR_EMBEDDING_MODEL=alias-qwen3-8b-embeddings

# Optional invocation-time fallback. It must name another configured provider.
FALLBACK_PROVIDER=openai

# DEFAULT_MODEL remains accepted for one compatibility release. New
# configurations should use OPENAI_DEFAULT_MODEL or BLABLADOR_DEFAULT_MODEL.

# =============================================================================
# OPTIONAL: model and external-tool settings
# =============================================================================
MAX_TOKENS=10000
# Timeout for ordinary UI/API calls and for stream connection/write setup.
# Streaming response reads remain open while the agent is working.
TIMEOUT_SECONDS=60
MAX_RETRIES=3

# Context7 gives software-specialist external library/framework documentation.
# CONTEXT7_API_KEY=your-context7-api-key-here
# CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
# CONTEXT7_TIMEOUT_SECONDS=30

# Tavily gives neutron-research-specialist optional current-web search.
# TAVILY_API_KEY=tvly-your-tavily-api-key-here

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=juena

# =============================================================================
# OPTIONAL: isolated Python and shell execution
# =============================================================================
# Keep this false until the host-side rootless-Podman broker is running.
# `juena up` starts that broker for development; production uses systemd.
SANDBOX_ENABLED=false
# Development-only UI preview. The chip is visible but cannot send an execution
# request until SANDBOX_ENABLED=true. Production rejects this preview-only mode.
SANDBOX_STARTER_PREVIEW=true
# Native processes use 127.0.0.1. Containers reach the same host broker through
# host.docker.internal, which the Compose files configure automatically.
SANDBOX_BROKER_URL=http://127.0.0.1:8090
# Generate with: openssl rand -hex 32
# SANDBOX_BROKER_TOKEN=replace-with-at-least-32-random-characters
# Optional broker overrides. `juena up` resolves the Podman API socket and a
# repository-local ignored workspace automatically. Broker-process settings such
# as SANDBOX_PODMAN_URI belong in the broker's own env file -- see
# deploy/sandbox-broker.env.example.
# SANDBOX_IMAGE=juena-sandbox:latest
# SANDBOX_WORKSPACE_ROOT=/var/lib/juena-sandbox/workspaces
SANDBOX_BROKER_TIMEOUT_SECONDS=620
SANDBOX_EXECUTION_TIMEOUT_SECONDS=600
SANDBOX_MAX_OUTPUT_BYTES=100000
SANDBOX_ARTIFACT_ROOT=/data/artifacts
SANDBOX_AUDIT_FILE=/data/audit/sandbox.jsonl

# =============================================================================
# Server and browser origins
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
UI_PORT=9501

# Private, server-side URL used only by Streamlit when calling FastAPI.
JUENA_API_INTERNAL_URL=http://localhost:8080
# Browser-facing FastAPI/gateway origin used to build login links.
JUENA_PUBLIC_URL=http://localhost:8080
# Compatibility setting for the post-login UI destination. Development uses a
# separate Streamlit port; production should use the same HTTPS gateway origin
# as JUENA_PUBLIC_URL. This alias is retained for one release.
UI_PUBLIC_URL=http://localhost:9501

# =============================================================================
# Environment and Postgres persistence
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=/tmp/logs
# Peak allowance for repository bootstrap and the combined development service.
JUENA_MEMORY_LIMIT=12G

# Credentials for the `postgres` Compose service. The base compose file has NO
# default for POSTGRES_PASSWORD: leave it unset in production and the container
# refuses to initialise, which surfaces minutes later as a health-check timeout
# on a service that looks unrelated. Production must supply a generated value
# and keep DATABASE_URL below in step with it.
POSTGRES_DB=juena
POSTGRES_USER=juena
POSTGRES_PASSWORD=juena-development-only
# Host port for the development Postgres publish (docker-compose.dev.yml only).
# POSTGRES_PORT=5432

# For running JüNA natively on the host (`juena run`), where Postgres is reached
# on localhost. Compose does NOT use this value: it builds the container DSN
# from the POSTGRES_* settings above against the `postgres` service, because a
# localhost DSN inside a container points at the container itself.
DATABASE_URL=postgresql://juena:juena-development-only@localhost:5432/juena
# DATABASE_POOL_MAX_SIZE=20
# How long an issued session cookie stays valid.
# SESSION_TTL_HOURS=8

# =============================================================================
# FZJ SAML2 service provider
# =============================================================================
SAML_IDP_METADATA_URL=https://ifflogin.fz-juelich.de/saml/idp.xml
SAML_SP_ENTITY_ID=http://localhost:8080/auth/metadata
SAML_SP_ACS_URL=http://localhost:8080/auth/acs
SAML_SP_SLS_URL=http://localhost:8080/auth/sls
SAML_SP_CERT_FILE=/data/saml/sp.crt
SAML_SP_KEY_FILE=/data/saml/sp.key
SESSION_COOKIE_SECURE=false

# Production must explicitly provide public HTTPS values. Configuration fails
# closed for missing/non-HTTPS public and SAML URLs or insecure cookies.
# ENVIRONMENT=production
# JUENA_API_INTERNAL_URL=http://localhost:8080
# JUENA_PUBLIC_URL=https://juena.fz-juelich.de
# UI_PUBLIC_URL=https://juena.fz-juelich.de
# SAML_SP_ENTITY_ID=https://juena.fz-juelich.de/auth/metadata
# SAML_SP_ACS_URL=https://juena.fz-juelich.de/auth/acs
# SAML_SP_SLS_URL=https://juena.fz-juelich.de/auth/sls
# SESSION_COOKIE_SECURE=true

# Development-only authentication bypass. It is rejected in production.
AUTH_DEV_BYPASS=false

# =============================================================================
# Development settings
# =============================================================================
RELOAD=false
