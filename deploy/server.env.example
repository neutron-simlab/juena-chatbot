# Copy to /etc/juena/juena.env (mode 0600). Replace every CHANGE_ME value.
# Use URL-safe random hex database passwords: openssl rand -hex 32.
COMPOSE_PROJECT_NAME=juena-chatbot
JUENA_IMAGE=juena-chatbot:dev-server
ENVIRONMENT=production
AUTH_DEV_BYPASS=false
RELOAD=false
LOG_LEVEL=INFO

POSTGRES_USER=juena
POSTGRES_DB=juena
POSTGRES_PASSWORD=CHANGE_ME_CHAT_DATABASE
POSTGRES_PORT=5432
RAG_POSTGRES_USER=juena_rag
RAG_POSTGRES_DB=juena_rag_corpus
RAG_POSTGRES_PASSWORD=CHANGE_ME_RAG_DATABASE

DEFAULT_PROVIDER=blablador
FALLBACK_PROVIDER=blablador
BLABLADOR_API_KEY=CHANGE_ME_MODEL_API_KEY
BLABLADOR_BASE_URL=https://api.blablador.fz-juelich.de/v1
BLABLADOR_EMBEDDING_MODEL=alias-qwen3-8b-embeddings
BLABLADOR_EMBEDDING_DIMENSION=4096

# Browser origin: one hostname for FastAPI, Streamlit and SAML.
JUENA_PUBLIC_URL=https://CHANGE_ME_DEV_HOST
UI_PUBLIC_URL=https://CHANGE_ME_DEV_HOST
SESSION_COOKIE_SECURE=true
JUENA_HTTPS_BIND=0.0.0.0
JUENA_HTTPS_PORT=443
# Host files: fullchain.pem and privkey.pem. Mounted read-only into nginx.
JUENA_TLS_DIR=/etc/juena/tls

# Separate, persistent SP signing key sp.key and certificate sp.crt.
# idp-metadata.crt is the independently verified IdP metadata trust certificate.
JUENA_SAML_DIR=/etc/juena/saml
SAML_SP_ENTITY_ID=https://CHANGE_ME_DEV_HOST/auth/metadata
SAML_SP_ACS_URL=https://CHANGE_ME_DEV_HOST/auth/acs
SAML_SP_SLS_URL=https://CHANGE_ME_DEV_HOST/auth/sls
SAML_SP_CERT_FILE=/data/saml/sp.crt
SAML_SP_KEY_FILE=/data/saml/sp.key
SAML_IDP_METADATA_URL=https://ifflogin.fz-juelich.de/saml/idp.xml
SAML_IDP_METADATA_CERT_FILE=/data/saml/idp-metadata.crt
SAML_METADATA_REFRESH_SECONDS=21600
SAML_ORGANIZATION_NAME=CHANGE_ME_ORGANIZATION
SAML_ORGANIZATION_URL=https://CHANGE_ME_ORGANIZATION_HOST
SAML_CONTACT_NAME=CHANGE_ME_TECHNICAL_CONTACT
SAML_CONTACT_EMAIL=CHANGE_ME_CONTACT_EMAIL

# Conservative 8 GiB pilot. Enable execution after host acceptance tests.
JUENA_MEMORY_LIMIT=3G
SANDBOX_ENABLED=false
SANDBOX_IDENTITY_SECRET=CHANGE_ME_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SANDBOX_WORKSPACE_HOST_ROOT=/var/lib/juena-sandbox/workspaces
SANDBOX_CONCURRENCY=1
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_WORKSPACE_LIMIT_BYTES=5368709120
SANDBOX_IDLE_TTL_SECONDS=86400
SANDBOX_EXECUTION_TIMEOUT_SECONDS=600
SANDBOX_MAX_OUTPUT_BYTES=100000
LANGSMITH_TRACING=false
LANGFUSE_TRACING=false
