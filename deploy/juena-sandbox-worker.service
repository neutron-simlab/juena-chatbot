[Unit]
Description=JüNA rootless Podman sandbox worker
After=podman.socket
Requires=podman.socket

# Deliberately not ordered against JüNA: the worker only needs Postgres, and
# JüNA reports the sandbox unavailable whenever this unit is not running.

[Service]
Type=simple
# Install in juena-sandbox's user manager, with loginctl enable-linger.
EnvironmentFile=/etc/juena/sandbox-worker.env
Environment=SANDBOX_PODMAN_URI=unix://%t/podman/podman.sock
WorkingDirectory=/opt/juena/juena-chatbot
ExecStart=/opt/juena/juena-chatbot/.venv/bin/python -m juena_core.sandbox.worker
Restart=on-failure
RestartSec=5
Delegate=yes
# Group-writable so JüNA (running as root in its container) and the worker
# share the workspace tree through the juena-sandbox group.
UMask=0007

[Install]
WantedBy=default.target
