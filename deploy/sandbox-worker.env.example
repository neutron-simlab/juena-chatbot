# Generated from the production environment by ./juena prod sandbox-setup.
# This is a reference, not an additional file to edit for the normal setup.
# The worker uses the host network, so Postgres stays on loopback. The sandbox_jobs
# table is the only channel between JüNA and the worker.
DATABASE_URL=postgresql://juena:replace-with-database-password@127.0.0.1:5432/juena

# The user service resolves its own rootless socket through %t.
SANDBOX_IMAGE=localhost/juena-sandbox:latest
# Explicit runtime for execution jobs with app-owned, group-writable workspaces.
SANDBOX_OCI_RUNTIME=crun
SANDBOX_WORKSPACE_ROOT=/var/lib/juena-sandbox/workspaces
# Must match JüNA's own SANDBOX_CONCURRENCY, which is what the API admits
# before it reports the sandbox busy.
SANDBOX_CONCURRENCY=1
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_PID_LIMIT=256
SANDBOX_TMPFS_SIZE=1g
SANDBOX_WORKSPACE_LIMIT_BYTES=5368709120
SANDBOX_IDLE_TTL_SECONDS=86400

# Other runtimes require separate installation and workspace/isolation tests.
# The production setup selects crun for the worker and its execution jobs.
