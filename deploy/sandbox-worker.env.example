# The worker runs on the host, so Postgres stays on loopback. The sandbox_jobs
# table is the only channel between JüNA and this process.
DATABASE_URL=postgresql://juena:replace-with-database-password@127.0.0.1:5432/juena

# The user service resolves its own rootless socket through %t.
SANDBOX_IMAGE=juena-sandbox:latest
SANDBOX_WORKSPACE_ROOT=/var/lib/juena-sandbox/workspaces
# Must match JüNA's own SANDBOX_CONCURRENCY, which is what the API admits
# before it reports the sandbox busy.
SANDBOX_CONCURRENCY=1
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_PID_LIMIT=256
SANDBOX_TMPFS_SIZE=1g
SANDBOX_WORKSPACE_LIMIT_BYTES=5368709120
SANDBOX_IDLE_TTL_SECONDS=86400

# Optional additional syscall isolation after runsc is installed and configured.
# SANDBOX_OCI_RUNTIME=runsc
