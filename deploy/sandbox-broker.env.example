# Shared with the JüNA API. Generate with: openssl rand -hex 32
SANDBOX_BROKER_TOKEN=replace-with-at-least-32-random-characters

# Podman API socket. Defaults to /run/user/<uid>/podman/podman.sock, which is
# where `systemctl --user enable --now podman.socket` publishes it.
SANDBOX_PODMAN_URI=unix:///run/user/1001/podman/podman.sock
SANDBOX_IMAGE=juena-sandbox:latest
SANDBOX_WORKSPACE_ROOT=/var/lib/juena-sandbox/workspaces
SANDBOX_CONCURRENCY=4
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PID_LIMIT=256
SANDBOX_TMPFS_SIZE=1g
SANDBOX_WORKSPACE_LIMIT_BYTES=5368709120
SANDBOX_IDLE_TTL_SECONDS=86400

# Optional additional syscall isolation after runsc is installed and configured.
# SANDBOX_OCI_RUNTIME=runsc
